# Deployment configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# This file is read by docker-compose AND passed into the API container, so it
# holds both. Never commit .env — it is gitignored.

# --- where things live on this host -----------------------------------------
# Absolute path to this checkout. Several mounts must be identical on the host
# and inside the API container, because the Docker daemon resolves the sandbox
# containers' bind mounts on the host.
REPO_ROOT=/home/temp-dev/devfarhan/salur

# Workspace directories, one per workspace. Never deleted.
SANDBOX_ROOT=/home/temp-dev/salurai-workspaces

# --- host identity ----------------------------------------------------------
# The API container runs as this uid:gid so files it writes into the mounts
# above belong to you. `id -u`, `id -g`.
HOST_UID=1000
HOST_GID=1000

# The host's `docker` group, so the bind-mounted socket is readable.
# Find it with: getent group docker | cut -d: -f3
DOCKER_GID=999

# --- exposure ---------------------------------------------------------------
# The only published port. The API is reachable only through /api on this port.
WEB_PORT=8080

# --- application ------------------------------------------------------------
# Required before any database connection or MCP credential can be stored.
# Generate one with: openssl rand -base64 32
CONNECTION_SECRET=

# Agent sandbox image. Built by the deploy skill: bun run sandbox:build
SANDBOX_IMAGE=salurai-sandbox:1

# OpenAI
OPENAI_API_KEY=

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=

# Custom OpenAI-compatible chat-completions endpoint
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# --- object storage (RustFS) ------------------------------------------------
# S3-compatible bucket for generated images. The `rustfs` compose service and
# the API both read these, so they live here rather than in apps/api/.env.
# Generate a secret with: openssl rand -base64 24
S3_BUCKET=salur-media
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=
