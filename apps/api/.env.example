# Copy to .env and fill in. Only the values you set are enabled in the picker.

# OpenAI
OPENAI_API_KEY=

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=

# Custom OpenAI-compatible chat-completions endpoint
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=

# Required before a database connection can be stored. Any long random string.
# Generate one with: openssl rand -base64 32
CONNECTION_SECRET=

# OpenRouter — image generation only; chat models come from the settings above.
# Without it the `generate_image` tool is not registered at all, and the rest of
# the app works unchanged. Note that image models bill per output *token*: one
# 1408x768 image is ~$0.03-$0.07, from a tool any prompt can reach. Set a spend
# limit on the key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Optional. Defaults to google/gemini-3.1-flash-image. google/gemini-3-pro-image
# is better and roughly 4x the price.
IMAGE_MODEL=

# Optional. Only for `bun dev` on the host: RustFS is unpublished in compose, so
# the compose hostname does not resolve outside it. In the deployment this is
# set to http://rustfs:9000 by docker-compose.yml and must be left blank here.
S3_ENDPOINT=
