# Serves the built console and puts the API behind the same origin.
#
# Same-origin is the point: the browser calls `/api/...` with no host and no
# CORS, exactly as it does behind vite's dev proxy, so the client code is
# identical in development and deployment.
:8080 {
	encode zstd gzip

	# Streaming, not buffered. /api/chat is Server-Sent Events, and a proxy that
	# buffers turns a live transcript into one block of text at the end.
	handle /api/* {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv

		# Asset filenames carry a content hash, so a given URL never changes
		# meaning and may be cached forever.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# index.html is the one file whose URL is stable while its contents
		# change every deploy. Without this it had no Cache-Control at all, so
		# browsers applied heuristic freshness and could keep serving a stale
		# copy — which pins the whole app to the previous bundle.
		header /index.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"

		# Single-page app: every unknown path is a client route, not a 404.
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
