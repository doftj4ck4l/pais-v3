{
  "name": "pixelspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "on-prem": "scripts/pixelspace",
    "on-prem:test": "bun test scripts/pixelspace.test.ts",
    "sandbox:build": "bun run --filter ./apps/api sandbox:build",
    "dev": "bun run --filter ./apps/api dev & bun run --filter ./apps/web dev",
    "dev:api": "bun run --filter ./apps/api dev",
    "dev:web": "bun run --filter ./apps/web dev"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0"
  }
}
